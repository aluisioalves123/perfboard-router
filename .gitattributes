# Normaliza fim de linha. O que importa de verdade: script de shell e arquivo de
# configuração do Linux TEM que ir com LF — clonado com CRLF, o VPS responde
# "bad interpreter: /bin/bash^M" e o serviço não sobe.
* text=auto

*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.bat       text eol=crlf

# Mesma razao para os arquivos da variante em container: o Caddy e o Docker leem
# estes dentro do Linux, e CRLF vindo de um clone no Windows quebraria os dois.
Dockerfile  text eol=lf
*.yml       text eol=lf
Caddyfile*  text eol=lf
